#!/bin/sh
# NAnnersVRhub launch guard. Use in a game's Steam launch options:
#   "/path/to/vrhub/vrhub-check" <game-id> %command%
# Starts the game only if every required mod is installed; otherwise says what is missing and stops.
# Other games allow VRHUB_SKIP_CHECK=1 / broken-checker fallback.
# Elden Ring always stops on adapter failure and never bypasses its launch checks.
game="$1"
shift
here="$(cd "$(dirname "$0")" && pwd)"
if [ "$game" = "elden-ring" ]; then
  PYTHONPATH="$here" exec python3 -m vrhub.elden_ring "$@"
fi
if [ -z "$VRHUB_SKIP_CHECK" ]; then
  out="$(PYTHONPATH="$here" python3 -m vrhub.cli verify "$game" --quiet 2>&1)"
  rc=$?
  if [ "$rc" -eq 1 ]; then
    echo "$out" >&2
    command -v notify-send >/dev/null 2>&1 && notify-send -u critical "NAnnersVRhub: game not started" "$(echo "$out" | head -n 6)"
    exit 1
  fi
  [ -n "$out" ] && echo "$out" >&2
fi
exec "$@"
